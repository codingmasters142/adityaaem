Options -Indexes
RewriteEngine On

AddType image/webp .webp
<IfModule mod_headers.c>
    # Caches must keep the WebP and original versions of an image apart
    <FilesMatch "\.(jpe?g|png|webp)$">
        Header append Vary Accept
    </FilesMatch>
</IfModule>

# Force HTTPS and the bare domain https://adityaaem.in (live server only, skip localhost).
# Behind Hostinger's CDN the request may reach the server as plain http, so also trust
# X-Forwarded-Proto (otherwise the redirect loops forever).
RewriteCond %{HTTP_HOST} !^(localhost|127\.0\.0\.1)(:\d+)?$ [NC]
RewriteCond %{HTTPS} !=on
RewriteCond %{HTTP:X-Forwarded-Proto} !=https
RewriteRule ^ https://adityaaem.in%{REQUEST_URI} [R=301,L,NE]

# www.adityaaem.in -> adityaaem.in
RewriteCond %{HTTP_HOST} ^www\. [NC]
RewriteRule ^ https://adityaaem.in%{REQUEST_URI} [R=301,L,NE]

# Remove trailing slashes (except root)
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_URI} ^(.+)/$
RewriteRule ^ %1 [R=301,L,NE]

# Redirect PHP requests to clean URLs (not form posts)
RewriteCond %{REQUEST_METHOD} !=POST
RewriteCond %{THE_REQUEST} \s/+(.+?)\.php(?:\?.*)?\s [NC]
RewriteRule ^ /%1 [R=301,L,NE]

# Serve the optimized WebP copy (foo.jpg.webp next to foo.jpg) to browsers that support it.
# Image paths in the HTML/CSS stay the same; other browsers and link-preview bots get the original.
RewriteCond %{HTTP_ACCEPT} image/webp
RewriteCond %{REQUEST_FILENAME} \.(jpe?g|png)$ [NC]
RewriteCond %{REQUEST_FILENAME}.webp -f
RewriteRule ^(.+\.(?:jpe?g|png))$ $1.webp [NC,T=image/webp,E=WEBP_SERVED:1,L]

# Real files and folders are served as-is
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# Route clean URLs to PHP files
RewriteRule ^about-us$ about-us.php [L]
RewriteRule ^categories$ categories.php [L]
RewriteRule ^category/([^/]+)$ category.php?slug=$1 [QSA,L]
RewriteRule ^category/([^/]+)/([^/]+)$ product.php?category=$1&slug=$2 [QSA,L]
RewriteRule ^clients$ clients.php [L]
RewriteRule ^gallery$ gallery.php [L]
RewriteRule ^blog$ blog.php [L]
RewriteRule ^blog/([^/]+)$ blog-detail.php?slug=$1 [QSA,L]
RewriteRule ^contact-us$ contact-us.php [L]
RewriteRule ^privacy-policy$ privacy-policy.php [L]
RewriteRule ^sitemap\.xml$ sitemap.php [L]
RewriteRule ^leads$ leads.php [QSA,L]

# Old service URLs (301 to the matching category, handled in PHP)
RewriteRule ^services$ services.php [L]
RewriteRule ^services/([^/]+)$ service-detail.php?slug=$1 [QSA,L]

# Unknown routes to 404
RewriteRule ^ 404.php [L]
